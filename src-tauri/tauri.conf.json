{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bolzano Jobs",
  "version": "2.0.0",
  "identifier": "com.p0mpurin.bolzanojobs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bolzano Jobs",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#000000",
        "center": true,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}